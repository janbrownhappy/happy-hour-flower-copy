{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_changelog_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_changelog": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailyChangelogEmail",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Email today's changelog",
            "description": "10pm daily digest"
          }
        }
      }
    ]
  },
  "description": "Every night at 10pm, emails the admin a list of all changelog entries logged that day.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 22 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Nightly Changelog Email"
}