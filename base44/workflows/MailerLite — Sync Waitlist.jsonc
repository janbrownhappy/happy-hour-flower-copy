{
  "name": "MailerLite \u2014 Sync Waitlist",
  "description": "Adds new waitlist signups to MailerLite to trigger the waitlist nurture sequence.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Waitlist"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "mailerlite_sync_waitlist",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncToMailerLite",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}