{
  "name": "Daily Review Summary Email",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_review_summary_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDailyReviewSummary",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Email daily review summary",
            "description": "8am daily"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every morning at 8am, emails the account owner a summary of the previous day's venue reviews, venue claims, imported venues awaiting review, and Instagram queue activity."
}