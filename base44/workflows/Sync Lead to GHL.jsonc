{
  "name": "Sync Lead to GHL",
  "description": "Adds captured leads (consumer or venue owner) into GoHighLevel for marketing sequences, tagged lead_consumer or lead_venue_owner.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Lead"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_lead_to_ghl",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncToGHL",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}