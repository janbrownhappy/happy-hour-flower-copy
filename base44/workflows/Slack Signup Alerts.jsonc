{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "app_user_auth",
      "events": [
        "signup"
      ]
    }
  },
  "description": "Posts new user signups to Slack",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_signup_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_slack": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifySlack",
            "args": {
              "category": "free",
              "event": "user_signup",
              "data": {
                "email": "${ .trigger.email }",
                "full_name": "${ .trigger.full_name }",
                "auth_method": "${ .trigger.auth_method }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post to Slack",
            "description": "Free signups channel"
          }
        }
      }
    ]
  },
  "name": "Slack Signup Alerts"
}