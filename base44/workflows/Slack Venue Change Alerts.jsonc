{
  "name": "Slack Venue Change Alerts",
  "description": "Posts new venues and key venue changes (name, status, address, verification, owner) to Slack",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "Venue",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.event_type == \"create\" or any((.trigger.changed_fields // [])[]; IN(\"name\", \"status\", \"address\", \"verification_status\", \"owner_id\", \"subscription_tier\")) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "slack_venue_change_alerts",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "post_slack": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifySlack",
            "args": {
              "category": "venues",
              "event": "${ if .trigger.event_type == \"create\" then \"venue_created\" else \"venue_updated\" end }",
              "data": {
                "id": "${ .trigger.entity_id }",
                "name": "${ .trigger.data.name }",
                "city": "${ .trigger.data.city }",
                "status": "${ .trigger.data.status }",
                "changed_fields": "${ .trigger.changed_fields }"
              }
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Post to Slack",
            "description": "Venue changes channel"
          }
        }
      }
    ]
  }
}