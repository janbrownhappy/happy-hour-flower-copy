{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every 5 minutes, advances the Phase 2.5 venue enrichment batches, runs the integrity check when a batch completes, and stops on safety or rate-limit problems.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "venue_enrichment_batch_runner",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_step": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runEnrichmentBatchStep",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Advance enrichment batch",
            "description": "~100s of venue work"
          }
        }
      }
    ]
  },
  "name": "Venue Enrichment Batch Runner"
}