{
  "name": "Sync Profile to GHL",
  "description": "Upserts the user's profile into GoHighLevel (email as key) on signup and whenever their subscription tier or status changes. Runs in parallel with the MailerLite sync \u2014 does not replace it.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Profile"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_profile_to_ghl",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncToGHL",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}