{
  "name": "Ad Status Email \u2014 Approved/Rejected",
  "description": "Emails the venue owner instantly when their ad campaign status changes to approved or rejected.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"approved\" or .trigger.data.status == \"rejected\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "AdCampaign"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "ad_status_email_approved_rejected",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onAdStatusChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}