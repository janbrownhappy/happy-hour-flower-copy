{
  "name": "New Venue Neighborhood Alert",
  "description": "Notifies users when a new venue becomes active in their saved neighborhood.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Venue"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_venue_neighborhood_alert",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyNewVenueInNeighborhood",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}