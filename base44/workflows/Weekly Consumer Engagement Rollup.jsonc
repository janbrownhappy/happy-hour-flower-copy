{
  "name": "Weekly Consumer Engagement Rollup",
  "description": "Every Monday at 2am: rolls up the prior completed week of consumer engagement into ConsumerEngagementRollup so churn scoring has a behavioral baseline.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * 1",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "weekly_consumer_engagement_rollup",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "rollup": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "rollupConsumerEngagement",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Roll up prior week",
            "description": "Per-consumer engagement"
          }
        }
      }
    ]
  }
}