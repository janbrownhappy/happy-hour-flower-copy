{
  "description": "Captures daily Executive KPI snapshots from HHF data, Stripe and Partnero",
  "name": "Daily KPI Snapshot",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 5 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_kpi_snapshot",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "collect": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "collectKpiSnapshots",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Collect KPI snapshots",
            "description": "All geographies"
          }
        }
      }
    ]
  }
}