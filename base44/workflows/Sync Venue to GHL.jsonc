{
  "name": "Sync Venue to GHL",
  "description": "Upserts the venue's contact into GoHighLevel (email as key) when a venue is created or updated, tagged venue_active.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Venue"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_venue_to_ghl",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncToGHL",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  }
}