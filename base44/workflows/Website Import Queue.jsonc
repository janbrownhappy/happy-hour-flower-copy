{
  "name": "Website Import Queue",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "website_import_queue",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_batch": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processWebsiteImportQueue",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Process next websites",
            "description": "6 URLs per run"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Every 5 minutes, researches and enriches the next queued venue website URLs in the background"
}