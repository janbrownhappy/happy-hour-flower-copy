  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 15 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "retention_prevention_outreach",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_outreach": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runRetentionOutreach",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send prevention outreach",
            "description": "Risk nudges + win-backs"
          }
        }
      }
    ]
  }
}