{
  "name": "ChurnScoringRule",
  "type": "object",
  "properties": {
    "rule_key": {
      "type": "string",
      "description": "Stable unique key for the rule (e.g. 'payment_failed', 'no_login_14d', 'engagement_decline')"
    },
    "label": {
      "type": "string",
      "description": "Human-friendly name shown to admins"
    },
    "description": {
      "type": "string",
      "description": "Short explanation of what condition fires this rule"
    },
    "applies_to": {
      "type": "string",
      "enum": [
        "consumer",
        "venue",
        "both"
      ],
      "default": "both",
      "description": "Which account type this rule evaluates against"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Risk points added to the churn score when this rule's condition is true"
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "description": "Severity band for the resulting signal"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "When false, this rule is skipped by the scoring engine"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the admin settings list"
    }
  },
  "required": [
    "rule_key",
    "points"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}