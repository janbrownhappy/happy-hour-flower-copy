{
  "name": "LocationNeighborhood",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Neighborhood name (e.g. Downtown / Main Street)"
    },
    "code": {
      "type": "string",
      "description": "Short neighborhood code (e.g. GVL-01)"
    },
    "city_id": {
      "type": "string",
      "description": "FK to LocationCity (Base44 id)"
    },
    "region_id": {
      "type": "string",
      "description": "FK to LocationRegion (Base44 id) \u2014 denormalized for fast filtering"
    },
    "state_id": {
      "type": "string",
      "description": "FK to LocationState (Base44 id) \u2014 denormalized for fast filtering"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this neighborhood is live/selectable in the app"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in dropdowns"
    }
  },
  "required": [
    "name",
    "city_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}