{
  "name": "NewsCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of the news category"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in dropdowns and filters"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "jan.brown@happyhourflower.com"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "jan.brown@happyhourflower.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "jan.brown@happyhourflower.com"
          }
        }
      ]
    }
  }
}