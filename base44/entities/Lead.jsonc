{
  "name": "Lead",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "maxLength": 100,
      "description": "First name"
    },
    "last_name": {
      "type": "string",
      "maxLength": 100,
      "description": "Last name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254,
      "description": "Email address"
    },
    "phone": {
      "type": "string",
      "pattern": "^[0-9+()\\-. ]{0,20}$",
      "description": "Phone number"
    },
    "role": {
      "type": "string",
      "enum": [
        "consumer",
        "venue_owner"
      ],
      "default": "consumer",
      "description": "Type of lead"
    },
    "venue_name": {
      "type": "string",
      "maxLength": 200,
      "description": "Venue name (for venue_owner leads)"
    },
    "zip_code": {
      "type": "string",
      "pattern": "^([0-9]{5}(-[0-9]{4})?)?$",
      "description": "ZIP code"
    },
    "source": {
      "type": "string",
      "maxLength": 100,
      "default": "landing_page",
      "description": "Where this lead came from"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "converted",
        "unsubscribed"
      ],
      "default": "new",
      "description": "Lead status"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000,
      "description": "Internal notes"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {},
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}