{
  "name": "KpiTarget",
  "type": "object",
  "properties": {
    "metric_key": {
      "type": "string"
    },
    "scope_level": {
      "type": "string",
      "enum": [
        "all",
        "state",
        "market"
      ],
      "default": "all"
    },
    "scope_id": {
      "type": "string",
      "default": "all"
    },
    "target_value": {
      "type": "number"
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "effective_to": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "metric_key",
    "target_value",
    "effective_from"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "jan.brown@happyhourflower.com"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "jan.brown@happyhourflower.com"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "jan.brown@happyhourflower.com"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "email": "jan.brown@happyhourflower.com"
          }
        }
      ]
    }
  }
}