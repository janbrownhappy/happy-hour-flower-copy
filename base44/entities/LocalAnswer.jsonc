{
  "name": "LocalAnswer",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "description": "FK to LocalQuestion (Base44 id) this answer belongs to"
    },
    "text": {
      "type": "string",
      "description": "The answer text"
    },
    "author_name": {
      "type": "string",
      "description": "Display name of the person who answered (denormalized for display)"
    },
    "is_hidden": {
      "type": "boolean",
      "default": false,
      "description": "Set true by an admin to hide a reported/inappropriate answer"
    }
  },
  "required": [
    "question_id",
    "text"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    }
  }
}