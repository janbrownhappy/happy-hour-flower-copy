      "type": "string",
      "description": "Stripe Price id for the weekday placement one-time purchase"
    },
    "weekend_stripe_price_id": {
      "type": "string",
      "description": "Stripe Price id for the weekend placement one-time purchase"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether ad sales are currently enabled"
    }
  },
  "required": [],
