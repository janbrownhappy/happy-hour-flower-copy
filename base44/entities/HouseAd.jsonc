{
  "name": "HouseAd",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Internal label / headline for the house ad (e.g. 'Happy Hour Flower \u2014 Spring')"
    },
    "image_url": {
      "type": "string",
      "description": "Hosted ad creative image URL"
    },
    "click_url": {
      "type": "string",
      "description": "Optional click-through destination URL"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this house ad is in the rotation"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in the admin list"
    },
    "impression_count": {
      "type": "number",
      "default": 0,
      "description": "Total times this house ad was shown to a consumer"
    },
    "click_count": {
      "type": "number",
      "default": 0,
      "description": "Total times a consumer clicked this house ad"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}