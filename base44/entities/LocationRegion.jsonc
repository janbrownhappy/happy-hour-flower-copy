{
  "name": "LocationRegion",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Region name (e.g. Upstate)"
    },
    "state_id": {
      "type": "string",
      "description": "FK to LocationState (Base44 id)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this region is live/selectable in the app"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order in dropdowns"
    }
  },
  "required": [
    "name",
    "state_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}